[Unit]
Description=PremiumBlue PIPC-011 Weboberfläche
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/PremiumBlue-PIPC-011-Python
ExecStart=/opt/PremiumBlue-PIPC-011-Python/.venv/bin/python -m pipc-011 -c /opt/PremiumBlue-PIPC-011-Python/config.yaml web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
